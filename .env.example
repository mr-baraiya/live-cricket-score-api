# Server Settings
HOST=0.0.0.0
PORT=6020

# CORS Configuration (comma-separated origins or * for all)
CORS_ORIGINS=*

# Scraper HTTP Settings
SCRAPER_TIMEOUT=10.0
SCRAPER_MAX_RETRIES=2

# In-Memory Cache Settings (TTL in seconds)
CACHE_TTL=3.0

# Vercel Blob Storage Configuration
BLOB_STORE_ID=your_blob_store_id
BLOB_READ_WRITE_TOKEN=your_blob_read_write_token
